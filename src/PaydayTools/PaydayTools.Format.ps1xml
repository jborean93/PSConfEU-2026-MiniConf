<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>PaydayTools.Payslip</Name>
      <ViewSelectedBy>
        <TypeName>PaydayTools.Payslip</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader />
          <TableColumnHeader />
          <TableColumnHeader />
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Employee</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Amount</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>PaidOn</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
